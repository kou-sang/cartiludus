# Config pública del cliente (se expone en el bundle; no son secrets). Mismo proyecto Firebase que CRYPTICUS.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# true = login de Google en el mismo dominio vía el proxy /__/auth del Worker (ver README).
VITE_AUTH_SAME_ORIGIN=
