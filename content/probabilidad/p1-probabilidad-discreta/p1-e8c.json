{
  "id": "p1-e8c",
  "version": 1,
  "subject": "probabilidad",
  "topic": "p1-probabilidad-discreta",
  "title": "Ej. 8(c) · Todas las urnas ocupadas",
  "statement": "Calcular la probabilidad de que al distribuir $n$ bolillas distintas en $n$ urnas numeradas se encuentren todas las urnas ocupadas.",
  "difficulty": 2,
  "steps": [
    {
      "id": "modelo",
      "kind": "setup",
      "prompt": "¿Cómo se relaciona con el ítem (a)?",
      "hint": "Cada bolilla elige una urna.",
      "cards": [
        {
          "text": "Muestra con reposición de tamaño $r = n$ de una población de $n$ urnas",
          "correct": true,
          "explanation": "Todas ocupadas con $n$ bolillas $\\iff$ ninguna urna se repite."
        },
        {
          "text": "Muestra sin reposición de tamaño $n$",
          "correct": false,
          "explanation": "Las bolillas pueden ir a la misma urna."
        },
        {
          "text": "$r = 1$",
          "correct": false,
          "explanation": "Se distribuyen $n$ bolillas, no una."
        },
        {
          "text": "Bolillas indistinguibles en urnas (Bose–Einstein)",
          "correct": false,
          "explanation": "Las bolillas son distintas."
        }
      ]
    },
    {
      "id": "res",
      "kind": "compute",
      "prompt": "Resultado:",
      "hint": "Aplicar (a) con $r = n$.",
      "cards": [
        {
          "text": "$\\dfrac{n!}{\\binom{2n-1}{n}}$",
          "correct": false,
          "explanation": "Usa el modelo de bolillas indistinguibles."
        },
        {
          "text": "$\\left(1 - \\tfrac1n\\right)^n$",
          "correct": false,
          "explanation": "Es la probabilidad de que una urna dada quede vacía."
        },
        {
          "text": "$\\dfrac{1}{n^n}$",
          "correct": false,
          "explanation": "Sólo cuenta una asignación favorable; hay $n!$."
        },
        {
          "text": "$\\dfrac{n!}{n^n}$",
          "correct": true,
          "explanation": "Con $r = n$: $\\tfrac{n!}{0!\\,n^n}$."
        }
      ]
    },
    {
      "id": "num",
      "kind": "interpret",
      "prompt": "Para $n = 6$ (seis tiradas de un dado), ¿qué valor resulta?",
      "hint": "$6! = 720$, $6^6 = 46656$.",
      "cards": [
        {
          "text": "$\\tfrac{1}{6}$",
          "correct": false,
          "explanation": "Sin relación con el conteo."
        },
        {
          "text": "$\\tfrac{5}{324} \\approx 0{,}0154$",
          "correct": true,
          "explanation": "$720 / 46656$."
        },
        {
          "text": "$\\tfrac{1}{720}$",
          "correct": false,
          "explanation": "Invierte el conteo favorable."
        },
        {
          "text": "$\\approx 0{,}335$",
          "correct": false,
          "explanation": "Es $(5/6)^6$: probabilidad de que una cara dada no salga."
        }
      ]
    }
  ]
}
