{
  "id": "p1-e8a",
  "version": 1,
  "subject": "probabilidad",
  "topic": "p1-probabilidad-discreta",
  "title": "Ej. 8(a) · Muestra sin repeticiones",
  "statement": "Se toma una muestra al azar con reposición de tamaño $r$ de una población de $n$ elementos. Calcular la probabilidad de que en la muestra obtenida no haya elementos repetidos.",
  "difficulty": 2,
  "steps": [
    {
      "id": "omega",
      "kind": "setup",
      "prompt": "¿Cuántas muestras posibles hay?",
      "hint": "Con reposición y ordenada.",
      "cards": [
        {
          "text": "$r^n$",
          "correct": false,
          "explanation": "Invierte base y exponente."
        },
        {
          "text": "$n^r$, equiprobables",
          "correct": true,
          "explanation": "Cada una de las $r$ extracciones tiene $n$ resultados."
        },
        {
          "text": "$\\binom{n+r-1}{r}$",
          "correct": false,
          "explanation": "Multiconjuntos: no son equiprobables bajo extracción al azar."
        },
        {
          "text": "$\\binom nr$",
          "correct": false,
          "explanation": "Cuenta subconjuntos: corresponde a extracción sin reposición y sin orden."
        }
      ]
    },
    {
      "id": "fav",
      "kind": "compute",
      "prompt": "¿Cuántas muestras sin repetidos hay?",
      "hint": "Variaciones sin repetición.",
      "cards": [
        {
          "text": "$\\binom nr$",
          "correct": false,
          "explanation": "Falta el orden: hay que multiplicar por $r!$."
        },
        {
          "text": "$(n-1)^r$",
          "correct": false,
          "explanation": "Exige evitar un elemento fijo, no evitar repeticiones."
        },
        {
          "text": "$n^r - n$",
          "correct": false,
          "explanation": "Resta sólo las muestras constantes."
        },
        {
          "text": "$n(n-1)\\cdots(n-r+1) = \\tfrac{n!}{(n-r)!}$",
          "correct": true,
          "explanation": "Cada extracción excluye los elementos ya obtenidos."
        }
      ]
    },
    {
      "id": "res",
      "kind": "compute",
      "prompt": "Resultado (válido para $r \\le n$):",
      "hint": "Si $r > n$ algún elemento se repite seguro.",
      "cards": [
        {
          "text": "$\\dfrac{r!}{n^r}$",
          "correct": false,
          "explanation": "No elige los elementos de la muestra."
        },
        {
          "text": "$\\dfrac{\\binom nr}{n^r}$",
          "correct": false,
          "explanation": "Mezcla un conteo sin orden con uno ordenado."
        },
        {
          "text": "$\\dfrac{n!}{(n-r)!\\, n^r} = \\prod_{i=0}^{r-1}\\left(1 - \\tfrac in\\right)$",
          "correct": true,
          "explanation": "Cociente de los dos conteos."
        },
        {
          "text": "$\\left(1 - \\tfrac1n\\right)^{r}$",
          "correct": false,
          "explanation": "Supone que cada extracción sólo debe evitar un elemento."
        }
      ]
    }
  ]
}
