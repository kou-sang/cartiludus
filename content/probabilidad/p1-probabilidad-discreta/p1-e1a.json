{
  "id": "p1-e1a",
  "version": 1,
  "subject": "probabilidad",
  "topic": "p1-probabilidad-discreta",
  "title": "Ej. 1(a) · Dos dados: espacio muestral",
  "statement": "Se arroja dos veces un dado equilibrado. Exhibir un espacio muestral que describa dicho experimento.",
  "difficulty": 1,
  "steps": [
    {
      "id": "omega",
      "kind": "setup",
      "prompt": "¿Qué espacio muestral describe el experimento?",
      "hint": "Cada resultado registra los dos lanzamientos, en orden.",
      "cards": [
        {
          "text": "$\\Omega = \\{1,\\dots,6\\}$",
          "correct": false,
          "explanation": "Describe un solo lanzamiento, no dos."
        },
        {
          "text": "$\\Omega = \\{1,\\dots,6\\}^2 = \\{(i,j) : 1 \\le i, j \\le 6\\}$",
          "correct": true,
          "explanation": "Pares ordenados (primer tiro, segundo tiro): describe todos los resultados posibles."
        },
        {
          "text": "$\\Omega = \\{\\{i,j\\} : 1 \\le i, j \\le 6\\}$",
          "correct": false,
          "explanation": "Conjuntos no ordenados: confunde $(1,2)$ con $(2,1)$ y los puntos dejan de ser equiprobables."
        },
        {
          "text": "$\\Omega = \\{2, 3, \\dots, 12\\}$",
          "correct": false,
          "explanation": "Es el conjunto de sumas posibles: pierde información y sus puntos no son equiprobables."
        }
      ]
    },
    {
      "id": "card",
      "kind": "compute",
      "prompt": "¿Cuántos elementos tiene $\\Omega$?",
      "hint": "Principio de multiplicación.",
      "cards": [
        {
          "text": "$30$",
          "correct": false,
          "explanation": "Excluye los pares con resultados iguales, que también son posibles."
        },
        {
          "text": "$36$",
          "correct": true,
          "explanation": "$6 \\cdot 6 = 36$ pares ordenados."
        },
        {
          "text": "$12$",
          "correct": false,
          "explanation": "Confunde producto con suma: $6 + 6$."
        },
        {
          "text": "$21$",
          "correct": false,
          "explanation": "Cuenta pares no ordenados (multiconjuntos de tamaño 2), no pares ordenados."
        }
      ]
    },
    {
      "id": "prob",
      "kind": "property",
      "prompt": "¿Qué medida de probabilidad corresponde sobre $\\Omega$?",
      "hint": "Dado equilibrado y tiros independientes.",
      "cards": [
        {
          "text": "$P(\\{(i,j)\\}) = \\tfrac{1}{21}$",
          "correct": false,
          "explanation": "Sólo sería válido si los pares no ordenados fueran equiprobables, y no lo son."
        },
        {
          "text": "Equiprobable: $P(\\{(i,j)\\}) = \\tfrac{1}{36}$ para cada par",
          "correct": true,
          "explanation": "Cada par tiene probabilidad $\\tfrac16 \\cdot \\tfrac16$; luego $P(A) = \\tfrac{\\#A}{36}$."
        },
        {
          "text": "$P(\\{(i,j)\\}) = \\tfrac{i+j}{252}$",
          "correct": false,
          "explanation": "Suma 1 pero no refleja el dado equilibrado: no hay motivo para favorecer sumas altas."
        },
        {
          "text": "$P(\\{(i,j)\\}) = \\tfrac{1}{6}$",
          "correct": false,
          "explanation": "La suma sobre los 36 pares daría $6 \\neq 1$."
        }
      ]
    }
  ]
}
