  "subject": "probabilidad",
  "topic": "p4-va-continuas",
  "title": "Ej. 9(a) · Pilas: parámetros de las falladas",
  "statement": "Una fábrica produce pilas cuya duración (en horas) tiene distribución $\\mathcal N(53, 25)$. Por un desperfecto, una proporción $0{,}7$ tiene esa duración y el resto está fallada, con duración $\\mathcal N(\\mu_1, \\sigma_1^2)$ de parámetros desconocidos. Sea $D$ la duración de una pila extraída al azar. Calcular $\\mu_1$ y $\\sigma_1^2$ sabiendo que $P(D \\ge 47) = 0{,}82688$ y $P(D \\ge 60) = 0{,}05746$.",
  "difficulty": 3,
  "steps": [
    {
      "id": "mezcla",
      "kind": "setup",
      "prompt": "¿Cómo se escribe $P(D \\ge t)$?",
      "hint": "Probabilidad total según el tipo de pila.",
      "cards": [
        {
          "text": "$P(N_0 \\ge t)\\,P(N_1 \\ge t)$",
          "correct": false,
          "explanation": "No hay producto."
        },
        {
          "text": "$P(\\mathcal N(0{,}7\\cdot 53 + 0{,}3\\mu_1, \\cdot) \\ge t)$",
          "correct": false,
          "explanation": "Una mezcla de normales no es normal."
        },
        {
          "text": "$0{,}7\\,P(N_0 \\ge t) + 0{,}3\\,P(N_1 \\ge t)$ con $N_0 \\sim \\mathcal N(53,25)$, $N_1 \\sim \\mathcal N(\\mu_1,\\sigma_1^2)$",
          "correct": true,
          "explanation": "Mezcla de dos normales con pesos $0{,}7$ y $0{,}3$."
        },
        {
          "text": "$P(0{,}7 N_0 + 0{,}3 N_1 \\ge t)$",
          "correct": false,
          "explanation": "Confunde mezcla con combinación lineal de variables."
        }
      ]
    },
    {
      "id": "z",
      "kind": "compute",
      "prompt": "¿Qué valores de $P(N_1 \\ge 47)$ y $P(N_1 \\ge 60)$ se obtienen?",
      "hint": "$P(N_0 \\ge 47) = P(Z \\ge -1{,}2) \\approx 0{,}8849$ y $P(N_0 \\ge 60) = P(Z \\ge 1{,}4) \\approx 0{,}0808$.",
      "cards": [
        {
          "text": "$\\approx 0{,}6914$ y $\\approx 0{,}0031$",
          "correct": true,
          "explanation": "$(0{,}82688 - 0{,}7\\cdot0{,}8849)/0{,}3$ y $(0{,}05746 - 0{,}7 \\cdot 0{,}0808)/0{,}3$."
        },
        {
          "text": "$\\approx 0{,}2074$ y $\\approx 0{,}0009$",
          "correct": false,
          "explanation": "Falta dividir por $0{,}3$."
        },
        {
          "text": "$0{,}82688$ y $0{,}05746$",
          "correct": false,
          "explanation": "Ignora la mezcla."
        },
        {
          "text": "$\\approx 0{,}8849$ y $\\approx 0{,}0808$",
          "correct": false,
          "explanation": "Son las probabilidades de las pilas correctas."
        }
      ],
      "timeLimitSec": 240
    },
    {
      "id": "sist",
      "kind": "compute",
      "prompt": "Resolver para $\\mu_1, \\sigma_1$:",
      "hint": "$\\tfrac{47 - \\mu_1}{\\sigma_1} \\approx -0{,}5$ y $\\tfrac{60-\\mu_1}{\\sigma_1} \\approx 2{,}75$.",
      "cards": [
        {
          "text": "$\\mu_1 = 45$, $\\sigma_1^2 = 16$",
          "correct": false,
          "explanation": "Signo incorrecto al despejar $\\mu_1$."
        },
        {
          "text": "$\\mu_1 = 49$, $\\sigma_1^2 = 4$",
          "correct": false,
          "explanation": "Confunde desvío con varianza."
        },
        {
          "text": "$\\mu_1 = 49$, $\\sigma_1^2 = 16$",
          "correct": true,
          "explanation": "Restando: $13 = 3{,}25\\,\\sigma_1$, $\\sigma_1 = 4$; luego $\\mu_1 = 47 + 0{,}5 \\cdot 4$."
        },
        {
          "text": "$\\mu_1 = 53$, $\\sigma_1^2 = 25$",
          "correct": false,
          "explanation": "Son los parámetros de las pilas correctas."
        }
      ]
    }
  ]
}
