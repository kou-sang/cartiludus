{
  "id": "p4-e1a",
  "version": 2,
  "subject": "probabilidad",
  "topic": "p4-va-continuas",
  "title": "Ej. 1(a) · Diámetro: constante k",
  "statement": "El diámetro $D$ (en decímetros) del tronco de cierta especie de árboles es una variable aleatoria con densidad $f_D(x) = k\\,x\\,\\mathbb{1}_{(0,10)}(x)$. Hallar el valor de la constante $k$.",
  "difficulty": 1,
  "steps": [
    {
      "id": "cond",
      "kind": "property",
      "prompt": "¿Qué condiciones debe cumplir una densidad?",
      "hint": "Propiedades que definen una densidad.",
      "cards": [
        {
          "text": "$f_D(10) = 1$",
          "correct": false,
          "explanation": "Una densidad no se normaliza en un punto."
        },
        {
          "text": "$0 \\le f_D \\le 1$",
          "correct": false,
          "explanation": "Una densidad puede superar 1; lo que vale 1 es la integral."
        },
        {
          "text": "$f_D \\ge 0$ y $\\int_{-\\infty}^{\\infty} f_D = 1$",
          "correct": true,
          "explanation": "No negativa e integral total 1."
        },
        {
          "text": "$\\int_{-\\infty}^{\\infty} f_D = 0$",
          "correct": false,
          "explanation": "La integral total es 1."
        }
      ]
    },
    {
      "id": "signo",
      "kind": "property",
      "prompt": "¿Qué signo debe tener $k$?",
      "hint": "En $(0, 10)$, $x > 0$.",
      "cards": [
        {
          "text": "$k = 0$",
          "correct": false,
          "explanation": "Entonces la integral sería 0, no 1."
        },
        {
          "text": "$k < 0$",
          "correct": false,
          "explanation": "Daría una densidad negativa."
        },
        {
          "text": "$k > 0$",
          "correct": true,
          "explanation": "Si $k < 0$ la densidad sería negativa en $(0,10)$."
        },
        {
          "text": "Cualquiera",
          "correct": false,
          "explanation": "La densidad debe ser no negativa."
        }
      ]
    },
    {
      "id": "int",
      "kind": "compute",
      "prompt": "¿Cuánto vale $\\int_{-\\infty}^{\\infty} f_D$ en función de $k$?",
      "hint": "Fuera de $(0,10)$ la densidad es 0.",
      "cards": [
        {
          "text": "$100k$",
          "correct": false,
          "explanation": "Olvida el $\\tfrac12$."
        },
        {
          "text": "$10k$",
          "correct": false,
          "explanation": "Integra la constante $k$ en lugar de $kx$."
        },
        {
          "text": "$k \\int_0^{10} x\\,dx = 50k$",
          "correct": true,
          "explanation": "$\\left.\\tfrac{x^2}{2}\\right|_0^{10} = 50$."
        },
        {
          "text": "$k$",
          "correct": false,
          "explanation": "Ignora el factor $x$."
        }
      ]
    },
    {
      "id": "res",
      "kind": "compute",
      "prompt": "Valor de $k$:",
      "hint": "$50k = 1$.",
      "cards": [
        {
          "text": "$k = \\tfrac{1}{100}$",
          "correct": false,
          "explanation": "Viene de $100k = 1$."
        },
        {
          "text": "$k = \\tfrac{1}{10}$",
          "correct": false,
          "explanation": "Viene de $10k = 1$."
        },
        {
          "text": "$k = 50$",
          "correct": false,
          "explanation": "Invierte la ecuación."
        },
        {
          "text": "$k = \\tfrac{1}{50}$",
          "correct": true,
          "explanation": "Despeje."
        }
      ]
    }
  ]
}
