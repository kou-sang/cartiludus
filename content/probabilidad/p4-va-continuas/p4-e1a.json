{
  "id": "p4-e1a",
  "version": 1,
  "subject": "probabilidad",
  "topic": "p4-va-continuas",
  "title": "Ej. 1(a) · Diámetro: constante k",
  "statement": "El diámetro $D$ (en decímetros) del tronco de cierta especie de árboles es una variable aleatoria con densidad $f_D(x) = k\\,x\\,\\mathbb{1}_{(0,10)}(x)$. Hallar el valor de la constante $k$.",
  "difficulty": 1,
  "steps": [
    {
      "id": "cond",
      "kind": "property",
      "prompt": "¿Qué condición determina $k$?",
      "hint": "Propiedades de una densidad.",
      "cards": [
        {
          "text": "$f_D(10) = 1$",
          "correct": false,
          "explanation": "Una densidad puede tomar valores mayores que 1 y no se normaliza puntualmente."
        },
        {
          "text": "$\\max f_D = 1$",
          "correct": false,
          "explanation": "La normalización es sobre la integral."
        },
        {
          "text": "$\\int_{-\\infty}^{\\infty} f_D = 1$ (y $k \\ge 0$)",
          "correct": true,
          "explanation": "Una densidad es no negativa e integra 1."
        },
        {
          "text": "$\\int_0^{10} x\\, dx = k$",
          "correct": false,
          "explanation": "Despeja mal: la condición es $k \\int_0^{10} x\\,dx = 1$."
        }
      ]
    },
    {
      "id": "res",
      "kind": "compute",
      "prompt": "Valor de $k$:",
      "hint": "$\\int_0^{10} x\\,dx = 50$.",
      "cards": [
        {
          "text": "$k = 50$",
          "correct": false,
          "explanation": "Invierte la ecuación."
        },
        {
          "text": "$k = \\tfrac{1}{100}$",
          "correct": false,
          "explanation": "Usa $\\int_0^{10} x\\,dx = 100$, olvidando el $\\tfrac12$."
        },
        {
          "text": "$k = \\tfrac{1}{50}$",
          "correct": true,
          "explanation": "$50k = 1$."
        },
        {
          "text": "$k = \\tfrac{1}{10}$",
          "correct": false,
          "explanation": "Normaliza como si fuera uniforme."
        }
      ]
    }
  ]
}
