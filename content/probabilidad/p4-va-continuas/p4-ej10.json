      ],
      "cards": [
        {
          "text": "Decreciente",
          "correct": false,
          "explanation": "Cada tramo es creciente."
        },
        {
          "text": "Continua y estrictamente creciente: $W \\in (0,2]$ en el primer tramo, $(2, 23]$ en el segundo y $(23, \\infty)$ en el tercero",
          "correct": true,
          "explanation": "Los tramos empalman en 2 y en 23."
        },
        {
          "text": "Tiene saltos en 8 y en 15",
          "correct": false,
          "explanation": "Los valores empalman."
        },
        {
          "text": "$W \\in (0, 8]$ en el primer tramo",
          "correct": false,
          "explanation": "Hay que aplicar $g$, no mirar $X$."
        }
      ]
    },
    {
      "id": "c-inv",
      "kind": "compute",
      "item": "(c)",
      "prompt": "¿Cuál es la inversa $x = g^{-1}(w)$ en cada tramo?",
      "hints": [
        "$w = x^{1/3}$; $w = \\tfrac17(x-1)^2 - 5$ con $x > 1$; $w = 2x - 7$."
