          "correct": false,
          "explanation": "Falta el caso de Aurora sola."
        },
        {
          "text": "$e^{-1{,}6} \\approx 0{,}202$",
          "correct": false,
          "explanation": "Ignora a Belinda."
        }
      ],
      "timeLimitSec": 180,
      "item": "(b)"
    },
    {
      "id": "c-mono",
      "kind": "property",
      "item": "(c)",
      "prompt": "¿Cómo es $g$ y qué valores toma $W$?",
      "hints": [
