{
  "id": "p4-e3a",
  "version": 1,
  "subject": "probabilidad",
  "topic": "p4-va-continuas",
  "title": "Ej. 3(a) · Transformación lineal",
  "statement": "Sea $X \\sim \\mathcal{U}[0, 1]$. Hallar las funciones de distribución y de densidad de $Y = cX + d$ ($c \\neq 0$).",
  "difficulty": 1,
  "steps": [
    {
      "id": "met",
      "kind": "setup",
      "prompt": "Para $c > 0$, ¿cómo se escribe $F_Y(y)$?",
      "hint": "Despejar $X$ preservando la desigualdad.",
      "cards": [
        {
          "text": "$F_Y(y) = 1 - F_X\\left(\\tfrac{y-d}{c}\\right)$",
          "correct": false,
          "explanation": "Corresponde a $c < 0$."
        },
        {
          "text": "$F_Y(y) = F_X(cy + d)$",
          "correct": false,
          "explanation": "Aplica la transformación en vez de su inversa."
        },
        {
          "text": "$F_Y(y) = c\\,F_X(y) + d$",
          "correct": false,
          "explanation": "Se transforma el argumento, no el valor de la acumulada."
        },
        {
          "text": "$F_Y(y) = P\\left(X \\le \\tfrac{y-d}{c}\\right) = F_X\\left(\\tfrac{y-d}{c}\\right)$",
          "correct": true,
          "explanation": "Multiplicar por $c > 0$ no invierte la desigualdad."
        }
      ]
    },
    {
      "id": "res",
      "kind": "distribution",
      "prompt": "Distribución de $Y$:",
      "hint": "Para $c<0$ el intervalo se invierte.",
      "cards": [
        {
          "text": "$Y \\sim \\mathcal{N}(d, c^2)$",
          "correct": false,
          "explanation": "No hay normalidad."
        },
        {
          "text": "$Y \\sim \\mathcal{U}$ en el intervalo de extremos $d$ y $c + d$; $f_Y = \\tfrac{1}{|c|}$ allí",
          "correct": true,
          "explanation": "Una transformación afín de una uniforme es uniforme."
        },
        {
          "text": "$Y \\sim \\mathcal{U}[d, c+d]$ con densidad $c$",
          "correct": false,
          "explanation": "La densidad es $1/|c|$; y si $c < 0$ el intervalo es $[c+d, d]$."
        },
        {
          "text": "$f_Y(y) = \\tfrac1c$ en $[d, c+d]$ para todo $c \\ne 0$",
          "correct": false,
          "explanation": "Si $c<0$ daría densidad negativa."
        }
      ]
    }
  ]
}
