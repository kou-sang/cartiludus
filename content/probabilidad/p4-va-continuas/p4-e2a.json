{
  "id": "p4-e2a",
  "version": 2,
  "subject": "probabilidad",
  "topic": "p4-va-continuas",
  "title": "Ej. 2(a) · Colectivo: esperar más de 10 minutos",
  "statement": "El colectivo que toma Felipe llega a la parada en algún momento entre las 10 y las 10:30 con distribución uniforme. Felipe llega a la parada a las 10. ¿Cuál es la probabilidad de que tenga que esperar más de 10 minutos?",
  "difficulty": 1,
  "steps": [
    {
      "id": "va",
      "kind": "distribution",
      "prompt": "Modelo para la espera de Felipe:",
      "hints": [
        "Medir el tiempo en minutos desde las 10."
      ],
      "cards": [
        {
          "text": "$T \\sim \\mathcal{N}(15, 30)$",
          "correct": false,
          "explanation": "El enunciado dice uniforme; además una normal toma valores fuera de $[0,30]$."
        },
        {
          "text": "$T \\sim \\mathcal{E}(\\tfrac1{30})$",
          "correct": false,
          "explanation": "El enunciado dice uniforme."
        },
        {
          "text": "$T \\sim \\mathcal{U}[0, 30]$",
          "correct": true,
          "explanation": "La espera coincide con el momento de llegada del colectivo."
        },
        {
          "text": "$T \\sim \\mathcal{U}[10, 30]$",
          "correct": false,
          "explanation": "El intervalo es de 10:00 a 10:30, es decir $[0, 30]$ minutos."
        }
      ]
    },
    {
      "id": "acum",
      "kind": "compute",
      "prompt": "¿Cuál es $F_T(t)$ para $0 \\le t \\le 30$?",
      "hints": [
        "Uniforme: proporcional a la longitud."
      ],
      "cards": [
        {
          "text": "$F_T(t) = \\tfrac{t}{30}$",
          "correct": true,
          "explanation": "$\\int_0^t \\tfrac{1}{30}\\,ds$."
        },
        {
          "text": "$F_T(t) = \\tfrac{1}{30}$",
          "correct": false,
          "explanation": "Es la densidad."
        },
        {
          "text": "$F_T(t) = 1 - \\tfrac{t}{30}$",
          "correct": false,
          "explanation": "Es $P(T > t)$."
        },
        {
          "text": "$F_T(t) = \\tfrac{t}{10}$",
          "correct": false,
          "explanation": "Escala incorrecta: el intervalo mide 30."
        }
      ]
    },
    {
      "id": "res",
      "kind": "compute",
      "prompt": "$P(T > 10)$:",
      "hints": [
        "$1 - F_T(10)$."
      ],
      "cards": [
        {
          "text": "$1 - \\tfrac{10}{30} = \\tfrac23$",
          "correct": true,
          "explanation": "Complemento de la acumulada."
        },
        {
          "text": "$e^{-1/3}$",
          "correct": false,
          "explanation": "Usa una exponencial."
        },
        {
          "text": "$\\tfrac13$",
          "correct": false,
          "explanation": "Es $P(T \\le 10)$."
        },
        {
          "text": "$\\tfrac{10}{30} \\cdot \\tfrac{20}{30}$",
          "correct": false,
          "explanation": "No corresponde a ningún evento del problema."
        }
      ]
    }
  ]
}
