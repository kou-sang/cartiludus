{
  "id": "p5-e3c",
  "version": 2,
  "subject": "probabilidad",
  "topic": "p5-vectores-aleatorios",
  "title": "Ej. 3(c) · Banco: un hombre y una mujer",
  "statement": "El número de hombres $H$ y de mujeres $M$ que ingresan por día a un banco son independientes con distribución $\\mathcal{P}(2)$ y $\\mathcal{P}(2{,}5)$. Sabiendo que en un día ingresaron sólo dos personas, calcular la probabilidad de que hayan sido un hombre y una mujer.",
  "difficulty": 2,
  "steps": [
    {
      "id": "suma",
      "kind": "distribution",
      "prompt": "¿Qué distribución tiene el total $H + M$?",
      "hints": [
        "Suma de Poisson independientes (convolución)."
      ],
      "cards": [
        {
          "text": "$H + M \\sim \\mathrm{Bi}(2, \\tfrac49)$",
          "correct": false,
          "explanation": "Esa es la distribución de $H$ dado el total, no la del total."
        },
        {
          "text": "$H + M \\sim \\mathcal{P}(4{,}5)$",
          "correct": true,
          "explanation": "La suma de Poisson independientes es Poisson con la suma de los parámetros."
        },
        {
          "text": "$H + M \\sim \\mathcal{P}(2{,}25)$",
          "correct": false,
          "explanation": "Promedia en lugar de sumar."
        },
        {
          "text": "$H + M \\sim \\mathcal{P}(5)$",
          "correct": false,
          "explanation": "Los parámetros se suman: $2 + 2{,}5$."
        }
      ]
    },
    {
      "id": "cond",
      "kind": "setup",
      "prompt": "Plantear:",
      "hints": [
        "$\\{H = 1, M = 1\\} \\subseteq \\{H + M = 2\\}$."
      ],
      "cards": [
        {
          "text": "$\\dfrac{P(H=1) + P(M=1)}{P(H+M=2)}$",
          "correct": false,
          "explanation": "Suma en lugar de intersecar."
        },
        {
          "text": "$\\dfrac{P(H=1)\\,P(M=1)}{P(H+M = 2)}$",
          "correct": true,
          "explanation": "Definición de condicional e independencia de $H$ y $M$."
        },
        {
          "text": "$\\dfrac{P(H=1)}{P(H+M=2)}$",
          "correct": false,
          "explanation": "Falta $M = 1$."
        },
        {
          "text": "$P(H=1)\\,P(M=1)$",
          "correct": false,
          "explanation": "Falta condicionar."
        }
      ]
    },
    {
      "id": "simp",
      "kind": "distribution",
      "prompt": "Al simplificar, ¿qué distribución tiene $H$ dado $H + M = 2$?",
      "hints": [
        "Cancelar $e^{-4{,}5}$ y los factoriales."
      ],
      "cards": [
        {
          "text": "$\\mathrm{Bi}(2, \\tfrac49)$",
          "correct": true,
          "explanation": "Cada persona es hombre con probabilidad $\\tfrac{\\lambda_H}{\\lambda_H + \\lambda_M}$."
        },
        {
          "text": "$\\mathrm{Bi}(2, \\tfrac12)$",
          "correct": false,
          "explanation": "Las tasas no son iguales."
        },
        {
          "text": "Uniforme en $\\{0, 1, 2\\}$",
          "correct": false,
          "explanation": "No hay razón para equiprobabilidad."
        },
        {
          "text": "$\\mathcal P(2)$",
          "correct": false,
          "explanation": "Ignora la condición."
        }
      ]
    },
    {
      "id": "res",
      "kind": "compute",
      "prompt": "Resultado:",
      "hints": [
        "$\\binom21 \\tfrac49 \\cdot \\tfrac59$."
      ],
      "cards": [
        {
          "text": "$\\tfrac12$",
          "correct": false,
          "explanation": "Supone $p = \\tfrac12$."
        },
        {
          "text": "$\\tfrac13$",
          "correct": false,
          "explanation": "Uniforme en los tres casos."
        },
        {
          "text": "$\\tfrac{20}{81}$",
          "correct": false,
          "explanation": "Falta el factor 2."
        },
        {
          "text": "$\\tfrac{40}{81} \\approx 0{,}494$",
          "correct": true,
          "explanation": "Binomial en $k = 1$."
        }
      ]
    }
  ]
}
