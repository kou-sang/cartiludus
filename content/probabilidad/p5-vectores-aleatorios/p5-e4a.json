{
  "id": "p5-e4a",
  "version": 1,
  "subject": "probabilidad",
  "topic": "p5-vectores-aleatorios",
  "title": "Ej. 4(a) · Trapecio: densidad y marginales",
  "statement": "Sea $(X, Y)$ un vector con densidad uniforme en el trapecio de vértices $(-6,0)$, $(-3,4)$, $(3,4)$, $(6,0)$. Obtener la densidad conjunta de $(X,Y)$ y las marginales de $X$ y de $Y$.",
  "difficulty": 2,
  "steps": [
    {
      "id": "conj",
      "kind": "compute",
      "prompt": "Densidad conjunta:",
      "hint": "Uniforme: constante igual a 1/área.",
      "cards": [
        {
          "text": "$\\tfrac{1}{72}$",
          "correct": false,
          "explanation": "Olvida dividir por 2 en el área del trapecio."
        },
        {
          "text": "$f(x,y) = \\tfrac{1}{36}$ en el trapecio",
          "correct": true,
          "explanation": "Área $= \\tfrac{(12 + 6)}{2} \\cdot 4 = 36$."
        },
        {
          "text": "$\\tfrac{1}{48}$",
          "correct": false,
          "explanation": "Usa el rectángulo $12 \\times 4$."
        },
        {
          "text": "$\\tfrac{1}{24}$",
          "correct": false,
          "explanation": "Usa el rectángulo $6 \\times 4$."
        }
      ]
    },
    {
      "id": "fy",
      "kind": "compute",
      "prompt": "Marginal de $Y$ ($0 \\le y \\le 4$):",
      "hint": "El corte horizontal a altura $y$ va de $-6 + \\tfrac34 y$ a $6 - \\tfrac34 y$.",
      "cards": [
        {
          "text": "$f_Y(y) = \\dfrac{6 + \\tfrac32 y}{36}$",
          "correct": false,
          "explanation": "El ancho decrece con $y$."
        },
        {
          "text": "$f_Y(y) = \\dfrac{12 - \\tfrac34 y}{36}$",
          "correct": false,
          "explanation": "Cada lado se corre $\\tfrac34 y$: el ancho baja $\\tfrac32 y$."
        },
        {
          "text": "$f_Y(y) = \\dfrac{12 - \\tfrac32 y}{36}$",
          "correct": true,
          "explanation": "Longitud del corte por la densidad."
        },
        {
          "text": "$f_Y(y) = \\tfrac14$",
          "correct": false,
          "explanation": "Supone $Y$ uniforme."
        }
      ]
    },
    {
      "id": "fx",
      "kind": "compute",
      "prompt": "Marginal de $X$:",
      "hint": "Para $3 < |x| < 6$ el lado oblicuo es $y = \\tfrac43(6 - |x|)$.",
      "cards": [
        {
          "text": "$f_X(x) = \\tfrac{1}{12}$ en $[-6, 6]$",
          "correct": false,
          "explanation": "Supone $X$ uniforme."
        },
        {
          "text": "$f_X(x) = \\dfrac{6-|x|}{36}$ en $[-6, 6]$",
          "correct": false,
          "explanation": "Corresponde a un triángulo, no al trapecio."
        },
        {
          "text": "$f_X(x) = \\tfrac19$ si $|x| \\le 3$; $\\dfrac{6 - |x|}{27}$ si $3 < |x| < 6$",
          "correct": true,
          "explanation": "Altura del corte vertical por $\\tfrac1{36}$; integra 1."
        },
        {
          "text": "$f_X(x) = \\tfrac19$ en $[-6,6]$",
          "correct": false,
          "explanation": "La altura disminuye fuera de $[-3, 3]$; no integra 1."
        }
      ]
    }
  ]
}
