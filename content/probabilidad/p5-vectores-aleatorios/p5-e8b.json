{
  "id": "p5-e8b",
  "version": 2,
  "subject": "probabilidad",
  "topic": "p5-vectores-aleatorios",
  "title": "Ej. 8(b) · Salto en largo: más de 8,2 m",
  "statement": "Tres atletas saltan de forma independiente; al equipo se le asigna la mejor distancia $M = \\max(A, B, C)$. $A \\sim \\mathcal U[7,9]$; $B$ tiene densidad $\\tfrac{9-x}{2}\\mathbb 1_{[7,9]}(x)$; $C$ tiene densidad $\\tfrac{x-7}{2}\\mathbb 1_{[7,9]}(x)$. Encontrar la probabilidad de que la distancia asignada sea mayor que 8,2.",
  "difficulty": 2,
  "steps": [
    {
      "id": "max",
      "kind": "property",
      "prompt": "¿Cómo se escribe $F_M(x) = P(M \\le x)$?",
      "hint": "$\\{\\max \\le x\\}$: los tres saltos son $\\le x$.",
      "cards": [
        {
          "text": "$F_M(x) = 1 - (1-F_A)(1-F_B)(1-F_C)$",
          "correct": false,
          "explanation": "Es la acumulada del mínimo."
        },
        {
          "text": "$F_M(x) = F_A(x)\\,F_B(x)\\,F_C(x)$",
          "correct": true,
          "explanation": "Intersección de eventos independientes."
        },
        {
          "text": "$F_M(x) = \\tfrac13(F_A + F_B + F_C)$",
          "correct": false,
          "explanation": "Corresponde a una mezcla."
        },
        {
          "text": "$F_M(x) = \\max(F_A, F_B, F_C)$",
          "correct": false,
          "explanation": "No es una identidad válida."
        }
      ]
    },
    {
      "id": "acum",
      "kind": "compute",
      "prompt": "Acumuladas en $[7, 9]$:",
      "hint": "Integrar cada densidad desde 7.",
      "cards": [
        {
          "text": "$F_A = \\tfrac{x}{9}$",
          "correct": false,
          "explanation": "Soporte incorrecto."
        },
        {
          "text": "$F_A = \\tfrac{x-7}2$, $F_B = 1 - \\tfrac{(9-x)^2}{4}$, $F_C = \\tfrac{(x-7)^2}{4}$",
          "correct": true,
          "explanation": "Integrales directas de las densidades."
        },
        {
          "text": "$F_C = \\tfrac{x-7}{2}$",
          "correct": false,
          "explanation": "Es la acumulada de $A$."
        },
        {
          "text": "$F_B = \\tfrac{(9-x)^2}4$",
          "correct": false,
          "explanation": "Es $P(B > x)$."
        }
      ]
    },
    {
      "id": "eval",
      "kind": "compute",
      "prompt": "Valores en $x = 8{,}2$:",
      "hint": "$x - 7 = 1{,}2$ y $9 - x = 0{,}8$.",
      "cards": [
        {
          "text": "$F_A = 0{,}6$, $F_B = 0{,}84$, $F_C = 0{,}6$",
          "correct": false,
          "explanation": "Usa $F_A$ para $C$."
        },
        {
          "text": "$F_A = 0{,}4$, $F_B = 0{,}84$, $F_C = 0{,}36$",
          "correct": false,
          "explanation": "$0{,}4$ es $P(A > 8{,}2)$."
        },
        {
          "text": "$F_A = 0{,}6$, $F_B = 0{,}84$, $F_C = 0{,}36$",
          "correct": true,
          "explanation": "$\\tfrac{1{,}2}{2}$, $1 - \\tfrac{0{,}64}{4}$, $\\tfrac{1{,}44}{4}$."
        },
        {
          "text": "$F_A = 0{,}6$, $F_B = 0{,}16$, $F_C = 0{,}36$",
          "correct": false,
          "explanation": "$0{,}16$ es $P(B > 8{,}2)$."
        }
      ]
    },
    {
      "id": "res",
      "kind": "compute",
      "prompt": "$P(M > 8{,}2)$:",
      "hint": "$1 - F_M(8{,}2)$.",
      "cards": [
        {
          "text": "$0{,}18144$",
          "correct": false,
          "explanation": "Es $P(M \\le 8{,}2)$."
        },
        {
          "text": "$\\tfrac13(0{,}4 + 0{,}16 + 0{,}64)$",
          "correct": false,
          "explanation": "Promedio de las colas: corresponde a una mezcla."
        },
        {
          "text": "$1 - 0{,}6 \\cdot 0{,}84 \\cdot 0{,}36 = 0{,}81856$",
          "correct": true,
          "explanation": "Complemento de la acumulada del máximo."
        },
        {
          "text": "$0{,}4 \\cdot 0{,}16 \\cdot 0{,}64$",
          "correct": false,
          "explanation": "Probabilidad de que los tres superen 8,2."
        }
      ]
    }
  ]
}
