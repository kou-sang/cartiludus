{
  "id": "p5-e3a",
  "version": 1,
  "subject": "probabilidad",
  "topic": "p5-vectores-aleatorios",
  "title": "Ej. 3(a) · Banco: separación de una Poisson",
  "statement": "El número de personas que ingresa por día a un banco es $N \\sim \\mathcal{P}(\\lambda)$. Cada persona es hombre con probabilidad $p$ y mujer con probabilidad $1-p$, independientemente. Mostrar que el número de hombres $H$ y de mujeres $M$ son independientes con distribución $\\mathcal P(\\lambda p)$ y $\\mathcal P(\\lambda(1-p))$.",
  "difficulty": 3,
  "steps": [
    {
      "id": "cond",
      "kind": "setup",
      "prompt": "¿Cómo se calcula $P(H = h, M = m)$?",
      "hints": [
        "$\\{H = h, M = m\\} = \\{N = h+m, H = h\\}$."
      ],
      "cards": [
        {
          "text": "$P(N = h+m)\\,p^h(1-p)^m$",
          "correct": false,
          "explanation": "Falta elegir quiénes son hombres."
        },
        {
          "text": "$\\binom{h+m}{h} p^h (1-p)^m$",
          "correct": false,
          "explanation": "Falta la probabilidad de que entren $h+m$ personas."
        },
        {
          "text": "$P(N = h+m)\\binom{h+m}{h} p^h (1-p)^m$",
          "correct": true,
          "explanation": "Dado $N = n$, $H \\sim \\mathrm{Bi}(n, p)$."
        },
        {
          "text": "$P(N = h)\\,P(N = m)$",
          "correct": false,
          "explanation": "Supone lo que se quiere probar y con parámetros incorrectos."
        }
      ]
    },
    {
      "id": "fact",
      "kind": "compute",
      "prompt": "Simplificar:",
      "hints": [
        "$e^{-\\lambda} = e^{-\\lambda p} e^{-\\lambda(1-p)}$ y $\\lambda^{h+m} = \\lambda^h\\lambda^m$."
      ],
      "cards": [
        {
          "text": "$\\dfrac{e^{-\\lambda p}(\\lambda p)^h}{h!} \\cdot \\dfrac{e^{-\\lambda(1-p)}(\\lambda(1-p))^m}{m!}$",
          "correct": true,
          "explanation": "Se cancela $(h+m)!$ y se reagrupan factores."
        },
        {
          "text": "$\\dfrac{e^{-\\lambda p}(\\lambda p)^h}{h!}$",
          "correct": false,
          "explanation": "Se perdió el factor de $M$."
        },
        {
          "text": "$\\dfrac{e^{-\\lambda}\\lambda^h}{h!}\\cdot\\dfrac{e^{-\\lambda}\\lambda^m}{m!}$",
          "correct": false,
          "explanation": "Parámetros incorrectos."
        },
        {
          "text": "$\\dfrac{e^{-\\lambda}(\\lambda p)^h (\\lambda(1-p))^m}{(h+m)!}$",
          "correct": false,
          "explanation": "No cancela $(h+m)!$ con el combinatorio."
        }
      ]
    },
    {
      "id": "concl",
      "kind": "property",
      "prompt": "¿Qué se concluye?",
      "hints": [
        "Una conjunta que factoriza."
      ],
      "cards": [
        {
          "text": "$H$ y $M$ son dependientes porque $H + M = N$",
          "correct": false,
          "explanation": "$N$ es aleatoria; la factorización prueba independencia."
        },
        {
          "text": "$H \\sim \\mathcal{P}(\\lambda)$",
          "correct": false,
          "explanation": "El parámetro es $\\lambda p$."
        },
        {
          "text": "La conjunta es producto de una función de $h$ y una de $m$: $H \\perp M$, $H \\sim \\mathcal P(\\lambda p)$, $M \\sim \\mathcal P(\\lambda(1-p))$",
          "correct": true,
          "explanation": "Factorización de la función de probabilidad conjunta en las marginales."
        },
        {
          "text": "$H \\sim \\mathrm{Bi}(N, p)$ marginalmente",
          "correct": false,
          "explanation": "Eso es sólo la condicional dado $N$."
        }
      ]
    }
  ]
}
