{
  "id": "p2-e3b",
  "version": 2,
  "subject": "probabilidad",
  "topic": "p2-condicional-independencia",
  "title": "Ej. 3(b) · Test diagnóstico: precisión requerida",
  "statement": "Sean $E$ = {la persona está enferma} y $A$ = {el análisis da positivo}. $P(A \\mid E)$ es la sensibilidad y $P(A^c \\mid E^c)$ la especificidad del test. Supongamos $P(A\\mid E) = P(A^c\\mid E^c) = p$ y $P(E) = 0{,}005$. ¿Para qué valor de $p$ es $P(E \\mid A) = 0{,}95$?",
  "difficulty": 3,
  "steps": [
    {
      "id": "fp",
      "kind": "property",
      "prompt": "¿Cuánto vale $P(A \\mid E^c)$ (falso positivo) en función de $p$?",
      "hints": [
        "Complemento de la especificidad."
      ],
      "cards": [
        {
          "text": "$1 - 0{,}005$",
          "correct": false,
          "explanation": "Es $P(E^c)$, no una probabilidad condicional del test."
        },
        {
          "text": "$p$",
          "correct": false,
          "explanation": "Es la especificidad: probabilidad de negativo en un sano."
        },
        {
          "text": "$0{,}005\\,p$",
          "correct": false,
          "explanation": "Es $P(A \\cap E)$."
        },
        {
          "text": "$1 - p$",
          "correct": true,
          "explanation": "$P(A\\mid E^c) = 1 - P(A^c \\mid E^c)$."
        }
      ]
    },
    {
      "id": "ec",
      "kind": "setup",
      "prompt": "Plantear la ecuación:",
      "hints": [
        "Bayes en función de $p$."
      ],
      "cards": [
        {
          "text": "$p = 0{,}95$",
          "correct": false,
          "explanation": "Confunde $P(A\\mid E)$ con $P(E\\mid A)$."
        },
        {
          "text": "$\\dfrac{0{,}005\\,p}{0{,}005\\,p + 0{,}995\\,p} = 0{,}95$",
          "correct": false,
          "explanation": "La tasa de falsos positivos es $1 - p$."
        },
        {
          "text": "$0{,}005\\,p = 0{,}95$",
          "correct": false,
          "explanation": "Falta normalizar por $P(A)$."
        },
        {
          "text": "$\\dfrac{0{,}005\\,p}{0{,}005\\,p + 0{,}995\\,(1-p)} = 0{,}95$",
          "correct": true,
          "explanation": "Numerador: positivos verdaderos; denominador: todos los positivos."
        }
      ]
    },
    {
      "id": "res",
      "kind": "compute",
      "prompt": "Valor de $p$:",
      "hints": [
        "Despejar: $0{,}00025\\,p = 0{,}94525\\,(1-p)$."
      ],
      "cards": [
        {
          "text": "$p = \\tfrac{0{,}94525}{0{,}9455} \\approx 0{,}99974$",
          "correct": true,
          "explanation": "Despeje lineal."
        },
        {
          "text": "$p \\approx 0{,}995$",
          "correct": false,
          "explanation": "Da $P(E\\mid A) \\approx 0{,}5$."
        },
        {
          "text": "$p = 0{,}95$",
          "correct": false,
          "explanation": "Con $p = 0{,}95$ resulta $P(E\\mid A) \\approx 0{,}087$."
        },
        {
          "text": "No existe tal $p$",
          "correct": false,
          "explanation": "El cociente es continuo y creciente en $p$ y tiende a 1."
        }
      ]
    },
    {
      "id": "int",
      "kind": "interpret",
      "prompt": "¿Qué muestra el resultado?",
      "hints": [
        "Comparar la tasa de falsos positivos con la prevalencia."
      ],
      "cards": [
        {
          "text": "La prevalencia no influye",
          "correct": false,
          "explanation": "Interviene directamente en Bayes."
        },
        {
          "text": "Cualquier test con precisión mayor a 0,9 alcanza",
          "correct": false,
          "explanation": "Con $p = 0{,}95$ sólo se obtiene $P(E\\mid A) \\approx 0{,}087$."
        },
        {
          "text": "Basta aumentar la sensibilidad",
          "correct": false,
          "explanation": "Lo que domina son los falsos positivos sobre los sanos."
        },
        {
          "text": "Con prevalencia baja, los falsos positivos deben ser del orden del 0,03 %",
          "correct": true,
          "explanation": "$1 - p \\approx 2{,}6 \\cdot 10^{-4}$, mucho menor que $P(E) = 0{,}005$."
        }
      ]
    }
  ]
}
