          "correct": true,
          "explanation": "$P(A \\mid E^c) = 1 - P(A^c \\mid E^c)$."
        },
        {
          "text": "$0{,}005$",
          "correct": false,
          "explanation": "Es la prevalencia."
        }
      ]
