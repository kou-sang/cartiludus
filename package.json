{
  "name": "cartiludus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cartiludus: práctica guiada de Probabilidad, Estadística y Análisis Real con cartas por paso.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run build:content && vite",
    "build:content": "tsx scripts/build-content.ts",
    "prebuild": "npm run build:content",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "dev:worker": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "deploy:dry": "npm run build && wrangler deploy --dry-run --outdir .wrangler/dry-run"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true
  },
  "dependencies": {
    "firebase": "^13.4.0",
    "katex": "^0.19.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261118.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "wrangler": "^4.164.0"
  }
}
